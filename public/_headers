/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'; script-src 'self' 'wasm-unsafe-eval'; script-src-elem 'self'; style-src 'self' 'unsafe-inline'; style-src-elem 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' blob: data:; worker-src 'self' blob:; manifest-src 'self'; connect-src 'self' https://ebndffutyrgybsduvijo.supabase.co wss://ebndffutyrgybsduvijo.supabase.co https://nominatim.openstreetmap.org https://api.qrserver.com https://server.arcgisonline.com https://*.tile.openstreetmap.org https://hooks.slack.com; frame-src 'self' https://view.officeapps.live.com; upgrade-insecure-requests
